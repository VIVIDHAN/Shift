<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:DeliveryApp.Services"
             x:Class="DeliveryApp.Views.DeliveryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F4F6">
    <Grid RowDefinitions="Auto, *">
        <!-- Top Blue Navigation Bar -->
        <Border Grid.Row="0" BackgroundColor="#1E4ED8" StrokeThickness="0" Margin="0" Padding="0">
            <Grid ColumnDefinitions="Auto, *" Padding="20, 15, 20, 15" ColumnSpacing="15" Margin="0, 30, 0, 0">
                <Label Grid.Column="0" Text="&#xe5c4;" FontFamily="MaterialIcons" TextColor="White" FontSize="28" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Dropoff" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Capture proof and complete delivery" TextColor="#BFDBFE" FontSize="14" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="15">
                
                <!-- Ready for Dropoff Banner -->
                <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#2563EB" StrokeThickness="0" StrokeShape="RoundRectangle 25" WidthRequest="40" HeightRequest="40">
                            <Label Text="&#xe55f;" FontFamily="MaterialIcons" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Ready for Dropoff" FontSize="16" FontAttributes="Bold" TextColor="#1E3A8A"/>
                            <Label Text="You have reached the customer location" FontSize="13" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Order Card (Copied and modified from Dashboard) -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.05" Offset="0,4" Radius="10" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout>
                        <!-- Header -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding OrderId, StringFormat='#ORD-{0}'}" FontSize="22" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Assigned at 10:30 AM" FontSize="12" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                            
                            <!-- Status Badge -->
                            <Border Grid.Column="1" BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10, 5" VerticalOptions="Start">
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <BoxView Color="#F59E0B" WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center"/>
                                    <Label Text="{Binding Status}" TextColor="#D97706" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        
                        <!-- Details -->
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="40, *" RowSpacing="15">
                            <!-- Customer -->
                            <Label Grid.Row="0" Grid.Column="0" Text="&#xe7fd;" FontFamily="MaterialIcons" TextColor="#4B5563" FontSize="24" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Customer" FontSize="12" TextColor="#6B7280"/>
                                    <Label Text="{Binding CustomerName}" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>
                                </VerticalStackLayout>
                                <!-- Phone Button -->
                                <Border Grid.Column="1" BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                                    <Label Text="&#xe0cd;" FontFamily="MaterialIcons" TextColor="#3B82F6" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                            
                            <!-- Package -->
                            <Label Grid.Row="1" Grid.Column="0" Text="&#xebcc;" FontFamily="MaterialIcons" TextColor="#4B5563" FontSize="24" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Items" FontSize="12" TextColor="#6B7280"/>
                                <Label Text="{Binding Items}" FontSize="15" FontAttributes="Bold" TextColor="#111827" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            
                            <!-- Address -->
                            <Label Grid.Row="2" Grid.Column="0" Text="&#xe55f;" FontFamily="MaterialIcons" TextColor="#4B5563" FontSize="24" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Delivery Address" FontSize="12" TextColor="#6B7280"/>
                                    <Label Text="{Binding Location}" FontSize="14" TextColor="#111827" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="1" BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12,6" VerticalOptions="End">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="&#xe55f;" FontFamily="MaterialIcons" TextColor="#3B82F6" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="Open in Maps" TextColor="#3B82F6" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Text="&#xe5cc;" FontFamily="MaterialIcons" TextColor="#3B82F6" FontSize="16" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMapsTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Proof of Delivery Section -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                    <Label Grid.Column="0" Text="Proof of Delivery" FontSize="18" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="&#xe86c;" FontFamily="MaterialIcons" TextColor="#10B981" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="Photo required" TextColor="#10B981" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Photo Placeholder / Captured Image -->
                <Border x:Name="PhotoBorder" Stroke="#D1D5DB" StrokeDashArray="5,5" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" BackgroundColor="#F9FAFB" HeightRequest="200" Padding="0">
                    <Grid>
                        <VerticalStackLayout x:Name="PhotoPlaceholder" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="20">
                            <!-- Camera Icon Circle -->
                            <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 30" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center">
                                <Label Text="&#xe412;" FontFamily="MaterialIcons" TextColor="#2563EB" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="No photo captured yet" TextColor="#4B5563" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Take a clear photo of the delivered items&#x0a;at the customer's location." TextColor="#9CA3AF" FontSize="12" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Image x:Name="CapturedImage" Aspect="AspectFill" IsVisible="false"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <VerticalStackLayout Spacing="10" Margin="0,10,0,20">
                    <Button x:Name="TakePhotoBtn"
                            Text="Take Photo of Delivery" 
                            ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xe412;, Color=White, Size=20}" 
                            Clicked="OnClickPhotoClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="8"
                            HeightRequest="55"/>

                    <Button x:Name="SubmitBtn"
                            Text="Submit Delivery" 
                            ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xe86c;, Color=White, Size=20}" 
                            Clicked="OnSubmitClicked"
                            BackgroundColor="#D1D5DB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="8"
                            HeightRequest="55"
                            IsEnabled="False"/>
                            
                    <Label x:Name="SubmitHelpText" Text="Please capture a photo to enable submission" TextColor="#9CA3AF" FontSize="12" HorizontalOptions="Center" Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="false" IsVisible="false" HorizontalOptions="Center" Color="#1E3A8A"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

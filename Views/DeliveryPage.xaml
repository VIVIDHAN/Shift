<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DeliveryApp.Views.DeliveryPage"
             Title="Dropoff"
             BackgroundColor="#F3F4F6">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            
            <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="OrderIdLabel" FontAttributes="Bold" FontSize="22" TextColor="#111827"/>
                    <BoxView HeightRequest="1" Color="#E5E7EB"/>
                    
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="&#xe7fd;" FontFamily="MaterialIcons" TextColor="#4B5563" FontSize="16" Grid.Column="0" VerticalOptions="Center"/>
                        <Label x:Name="CustomerLabel" FontSize="16" TextColor="#4B5563" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="&#xe1a1;" FontFamily="MaterialIcons" TextColor="#4B5563" FontSize="16" Grid.Column="0" VerticalOptions="Center"/>
                        <Label x:Name="ItemsLabel" FontSize="16" TextColor="#4B5563" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="30,*">
                        <Label Text="&#xe0c8;" FontFamily="MaterialIcons" TextColor="#4B5563" FontSize="16" Grid.Column="0" VerticalOptions="Center"/>
                        <Label x:Name="LocationLabel" FontSize="16" TextColor="#4B5563" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Proof of Delivery" FontSize="16" FontAttributes="Bold" TextColor="#111827" Margin="5,10,0,0"/>

            <Frame CornerRadius="15" Padding="0" IsClippedToBounds="True" BorderColor="#D1D5DB" BackgroundColor="#F9FAFB" HasShadow="False">
                <Grid>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="40">
                        <Label Text="&#xe412;" FontFamily="MaterialIcons" TextColor="#9CA3AF" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="No photo captured yet" TextColor="#9CA3AF" FontSize="14"/>
                    </VerticalStackLayout>
                    <Image x:Name="CapturedImage" HeightRequest="250" Aspect="AspectFill" IsVisible="false"/>
                </Grid>
            </Frame>

            <Button Text="Capture Photo" ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xe412;, Color=White, Size=20}" 
                    Clicked="OnClickPhotoClicked"
                    BackgroundColor="#3B82F6"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="55"/>

            <Button Text="Complete Delivery" ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xe86c;, Color=White, Size=20}" 
                    Clicked="OnSubmitClicked"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="55"
                    Margin="0,10,0,0"/>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="false" IsVisible="false" HorizontalOptions="Center" Color="#1E3A8A"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

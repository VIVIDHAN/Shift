<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:DeliveryApp.Services"
             x:Class="DeliveryApp.Views.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F3F4F6">
    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    
    <Grid BackgroundColor="#F3F4F6">
        <!-- Language Toggle -->
        <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="20,50,20,0" Spacing="8">
            <Label Text="English" TextColor="#4B5563" VerticalOptions="Center" FontSize="14" FontAttributes="Bold" />
            <Switch x:Name="LanguageToggle" Toggled="OnLanguageToggled" OnColor="#1E3A8A" ThumbColor="White" />
            <Label Text="தமிழ்" TextColor="#4B5563" VerticalOptions="Center" FontSize="14" FontAttributes="Bold" />
        </HorizontalStackLayout>

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="25" Padding="20">
            
            <!-- Logo Section -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="&#xe558;" FontFamily="MaterialIcons" TextColor="#1E3A8A" FontSize="80" HorizontalOptions="Center"/>
                <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[AppTitle]}" TextColor="#1E3A8A" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="2"/>
            </VerticalStackLayout>
            
            <!-- Login Card -->
            <Frame BackgroundColor="White" 
                   CornerRadius="25" 
                   Padding="25,25,25,35" 
                   HasShadow="True" 
                   BorderColor="Transparent"
                   WidthRequest="340">
                   
                <VerticalStackLayout Spacing="25">
                    
                    <!-- Role Switcher -->
                    <Frame BorderColor="#E5E7EB" CornerRadius="12" Padding="2" HasShadow="False" BackgroundColor="#F3F4F6">
                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="DriverBtn" Text="Driver" Clicked="OnRoleDriverClicked" BackgroundColor="#1E3A8A" TextColor="White" FontAttributes="Bold" CornerRadius="10" Grid.Column="0" HeightRequest="45" Padding="0"/>
                            <Button x:Name="AdminBtn" Text="Admin" Clicked="OnRoleAdminClicked" BackgroundColor="Transparent" TextColor="#6B7280" FontAttributes="Bold" CornerRadius="10" Grid.Column="1" HeightRequest="45" Padding="0"/>
                        </Grid>
                    </Frame>

                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Login]}" 
                           FontSize="24" 
                           TextColor="#111827"
                           HorizontalOptions="Center" 
                           FontAttributes="Bold"
                           x:Name="LoginTitleLabel"/>
                           
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[PhonePlaceholder]}" 
                           FontSize="14" 
                           TextColor="#6B7280"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           x:Name="LoginSubtitleLabel"/>

                    <!-- Phone Number Input -->
                    <Frame x:Name="PhoneFrame" BorderColor="#E5E7EB" CornerRadius="12" Padding="5,0,5,0" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="60">
                        <Grid ColumnDefinitions="50,*">
                            <Label Text="&#xe0cd;" FontFamily="MaterialIcons" TextColor="#9CA3AF" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="0"/>
                            <Entry x:Name="PhoneEntry"
                                   Placeholder="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[PhonePlaceholder]}"
                                   Keyboard="Telephone"
                                   FontSize="18"
                                   TextColor="#111827"
                                   PlaceholderColor="#9CA3AF"
                                   Grid.Column="1"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <!-- Password Input -->
                    <Frame BorderColor="#E5E7EB" CornerRadius="12" Padding="5,0,5,0" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="60">
                        <Grid ColumnDefinitions="50,*">
                            <Label Text="&#xe897;" FontFamily="MaterialIcons" TextColor="#9CA3AF" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="0"/>
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[PasswordPlaceholder]}"
                                   IsPassword="True"
                                   FontSize="18"
                                   TextColor="#111827"
                                   PlaceholderColor="#9CA3AF"
                                   Grid.Column="1"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <!-- Login Button -->
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Login]}"
                            Clicked="OnLoginClicked"
                            FontSize="18"
                            FontAttributes="Bold"
                            BackgroundColor="#1E3A8A"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="60"
                            Margin="0,10,0,0"
                            x:Name="SubmitLoginBtn"/>
                </VerticalStackLayout>
            </Frame>
            
        </VerticalStackLayout>
    </Grid>
</ContentPage>
